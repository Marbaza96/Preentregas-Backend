
<h2>Catálogo de servicios</h2>

<div id="services-list">
    {{#each services}}
    <article data-service-id="{{this._id}}">
        <h3>{{this.name}}</h3>
        <p>Descripción: {{this.description}}</p>
        <p>Duración: {{this.duration}} minutos</p>
        <p>Precio: ${{this.price}}</p>
        <p>Categoría: {{this.category}}</p>
        <p>Disponible:
            {{#if this.available}}Sí{{else}}No{{/if}}
        </p>
    </article>
    <hr>
    {{else}}
    <p id="services-empty-message">No hay servicios registrados.</p>
    {{/each}}
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/services.socket.js"></script>
